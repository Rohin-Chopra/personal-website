{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web: dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter web dev"
    },
    {
      "name": "Web: debug in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/web"
    },
    {
      "name": "API: debug Go tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/apps/api/internal/contact"
    }
  ]
}
