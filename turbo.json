{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "env": ["SHOW_DRAFTS", "VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": []
    },
    "test": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
